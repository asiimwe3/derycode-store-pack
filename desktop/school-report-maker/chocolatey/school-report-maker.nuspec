<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>school-report-maker</id>
    <version>2.3.28</version>
    <title>School Report Maker</title>
    <authors>DeryCode Technologies</authors>
    <owners>DeryCode Technologies</owners>
